// Cấu hình triển khai lên Cloudflare (Workers + Static Assets).
// Cloudflare chạy "build.command" để tạo thư mục dist/, rồi phát hành thư mục đó.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tien-do-thi-cong",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
